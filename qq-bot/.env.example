# 复制为 .env.dev 或 .env.prod 后按需修改。切勿把填好的真实 token 提交进仓库。

# ---- 驱动器与监听地址 ----
DRIVER=~fastapi+~websockets
HOST=0.0.0.0
PORT=8080

# ---- 日志 ----
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ---- 命令配置 ----
# 命令前缀，留空字符串表示无前缀也能触发
COMMAND_START=["/", ""]
COMMAND_SEP=["."]

# ---- 权限 ----
# 超级用户 QQ 号，字符串形式
SUPERUSERS=["10000"]
NICKNAME=["小助手"]

# ---- OneBot 客户端（NapCat / Lagrange / go-cqhttp）鉴权 ----
# 需与客户端反向 WebSocket 配置里的 token 一致，留空表示不校验
ONEBOT_ACCESS_TOKEN=

# ---- 业务插件配置 ----
# keyword 插件：关键词自动回复，JSON 对象
KEYWORD_REPLIES={"早上好": "早上好呀，今天也要加油！", "晚安": "晚安，好梦~"}
# keyword 插件：仅在这些群生效，空列表表示所有群
KEYWORD_GROUPS=[]
